APP_NAME=Bar Order Bot
ENVIRONMENT=test

POSTGRES_DB=barbot
POSTGRES_USER=barbot
POSTGRES_PASSWORD=change-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://barbot:change-local-password@db:5432/barbot
APP_PORT=8000
ADMINER_PORT=8080

BOT_TOKEN=
MINI_APP_BASE_URL=
LEADERBOARD_PSEUDONYM_SECRET=
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=replace-with-a-long-random-value

STAFF_TOKEN=replace-staff-token
ADMIN_TOKEN=replace-admin-token
OWNER_TOKEN=replace-owner-token
ANALYST_TOKEN=replace-analyst-token

OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo

# AI waiter. Leave ASSISTANT_API_KEY empty to reuse OPENAI_API_KEY.
ASSISTANT_ENABLED=true
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://openrouter.ai/api/v1
ASSISTANT_MODEL=google/gemini-3.1-flash-lite
ASSISTANT_TIMEOUT_SECONDS=25

# TheCocktailDB: key 1 is used in development/test only. Configure a production key.
COCKTAIL_DB_API_KEY=

STAFF_WARNING_MINUTES=5
STAFF_CRITICAL_MINUTES=10
LOG_LEVEL=INFO

SEED_DEMO=true
SQL_ECHO=false
